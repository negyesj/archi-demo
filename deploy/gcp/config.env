# archi-demo Google Cloud Run telepítés – beállítások.
# Minden érték felülírható környezeti változóval is, pl.:  REGION=europe-west1 ./04-deploy.sh

PROJECT_ID=${PROJECT_ID:-archi-demo-512819}   # a projekt AZONOSÍTÓJA (a neve: archi-demo)
REGION=${REGION:-europe-west1}               # Belgium ("Tier 1" árazás)
ZONE=${ZONE:-${REGION}-b}                   # figyelem: az europe-west1-ben nincs "-a" zóna (b, c, d)

# Artifact Registry tároló az image-eknek
AR_REPO=${AR_REPO:-archi}
IMAGE_TAG=${IMAGE_TAG:-latest}

# Hálózat: saját VPC, külön alhálózat az infrastruktúra VM-nek és a Cloud Run Direct VPC egressnek
NETWORK=${NETWORK:-archi-vpc}
SUBNET_INFRA=${SUBNET_INFRA:-archi-infra}
SUBNET_INFRA_RANGE=${SUBNET_INFRA_RANGE:-10.10.0.0/24}
SUBNET_RUN=${SUBNET_RUN:-archi-run}
SUBNET_RUN_RANGE=${SUBNET_RUN_RANGE:-10.10.1.0/24}
VPC_RANGE=${VPC_RANGE:-10.10.0.0/16}

# Infrastruktúra VM (PostgreSQL, MongoDB, Kafka, Redis Docker Compose-zal)
VM_NAME=${VM_NAME:-archi-infra}
VM_TYPE=${VM_TYPE:-e2-standard-4}
INFRA_IP=${INFRA_IP:-10.10.0.10}

# Szolgáltatásfiókok (rövid nevek)
RUN_SA=${RUN_SA:-archi-run}
INFRA_SA=${INFRA_SA:-archi-infra}
BUILD_SA=${BUILD_SA:-archi-build}

# Nyilvános elérés: --no-invoker-iam-check (szervezeti "domain restricted sharing" szabály mellett is működik)
# vagy a régebbi --allow-unauthenticated (allUsers run.invoker szerep).
PUBLIC_FLAG=${PUBLIC_FLAG:---no-invoker-iam-check}
