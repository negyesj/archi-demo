# Másolja .env néven. Éles környezetben minden titkot titoktárból (Secret Manager / Vault) adjon át!

# 256 bites AES kulcs base64-ben a titoktárhoz (openssl rand -base64 32)
PLATFORM_SECRET_KEY=TTsZW1jJLo3gR/wWcs/TOqP0/xfR9IkwQFJ6jz7KJMI=

# Keycloak master admin (a provisioner és az IAM ezzel hoz létre realmet, felhasználót, klienst)
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# A Keycloak böngészőből elérhető címe (a tokenek "iss" mezője)
